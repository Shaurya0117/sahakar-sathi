# Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite path (relative to the backend/ directory when running uvicorn)
DATABASE_URL=sqlite:///./cooperative.db

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development

# ─── Channel Integrations (WhatsApp & Voice) ───────────────────────────────────
# Set to "mock" for local offline testing, "twilio" or "telnyx" for live provider
WHATSAPP_PROVIDER=mock
VOICE_PROVIDER=mock

# Twilio Credentials (required only when WHATSAPP_PROVIDER=twilio or VOICE_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VOICE_NUMBER=+14155238886
TWILIO_WEBHOOK_SECRET=

# Telnyx WhatsApp Credentials (required only when WHATSAPP_PROVIDER=telnyx)
TELNYX_API_KEY=
TELNYX_WHATSAPP_NUMBER=+18001234567
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_WEBHOOK_SECRET=

