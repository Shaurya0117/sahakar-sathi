SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=sqlite:///./cooperative.db
PROOF_SECRET=your-random-secret-here-min-32-chars
PROOF_MAX_DISTANCE_M=500
PROOF_NONCE_GRACE_DAYS=2
PROOF_CODE_MAX_TRIES=5

# SMS Gateway (Voice Booking Dispatch)
SMS_GATEWAY=textbelt
TEXTBELT_KEY=textbelt
ANDROID_GW_URL=
ANDROID_GW_USER=
ANDROID_GW_PASS=

# SMS Webhook Secret (for Android SMS Gateway incoming reply webhook)
# Supported Setup Options in Android SMS Gateway:
# Option 1 (Custom Header - Recommended & Secure):
#   In app settings -> Webhooks -> Add Webhook:
#     URL: https://<your-domain>/api/sms/reply
#     Custom Headers: Name: "X-Webhook-Secret", Value: <your-secret-below>
# Option 2 (Query Parameter Fallback - for apps that cannot send custom headers):
#   In app settings -> Webhooks -> Add Webhook:
#     URL: https://<your-domain>/api/sms/reply?secret=<your-secret-below>
#   SECURITY NOTE: If using Option 2, run uvicorn with '--no-access-log' to avoid
#   printing ?secret= to console access logs. Proxies and ngrok will also log query URLs.
SMS_WEBHOOK_SECRET=your-random-sms-webhook-secret-here
